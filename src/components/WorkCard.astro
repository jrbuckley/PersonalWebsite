---
import type { WorkStatus } from '../content/work';

interface Props {
  title: string;
  context: string;
  role: string;
  outcome: string;
  tags: string[];
  href: string;
  status: WorkStatus;
  umamiEvent?: string;
  external?: boolean;
}

const {
  title,
  context,
  role,
  outcome,
  tags,
  href,
  status,
  umamiEvent,
  external = false,
} = Astro.props;
---

<article class="interactive-card bg-[color:var(--color-luxe-card)] border border-[color:var(--color-luxe-border)] rounded-lg p-6 h-full flex flex-col gap-4">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-xl font-semibold text-[color:var(--color-luxe-text)] m-0">
      <a
        href={href}
        class="hover:text-[color:var(--color-luxe-accent)] transition-colors focus:outline-none focus:ring-2 focus:ring-[color:var(--color-luxe-accent)] focus:ring-offset-2 focus:ring-offset-[color:var(--color-luxe-card)] rounded"
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        data-umami-event={umamiEvent}
      >
        {title}
      </a>
    </h3>
    <span class="shrink-0 text-xs font-medium px-2 py-1 rounded border border-[color:var(--color-luxe-border)] text-[color:var(--color-luxe-subtext)]">
      {status}
    </span>
  </div>
  <dl class="space-y-3 text-sm m-0">
    <div>
      <dt class="font-medium text-[color:var(--color-luxe-text)]">Problem</dt>
      <dd class="text-[color:var(--color-luxe-subtext)] m-0 mt-1">{context}</dd>
    </div>
    <div>
      <dt class="font-medium text-[color:var(--color-luxe-text)]">Role</dt>
      <dd class="text-[color:var(--color-luxe-subtext)] m-0 mt-1">{role}</dd>
    </div>
    <div>
      <dt class="font-medium text-[color:var(--color-luxe-text)]">Outcome</dt>
      <dd class="text-[color:var(--color-luxe-subtext)] m-0 mt-1">{outcome}</dd>
    </div>
  </dl>
  <ul class="flex flex-wrap gap-2 list-none m-0 p-0 mt-auto">
    {
      tags.map((tag) => (
        <li class="px-2 py-1 bg-[color:var(--color-luxe-background)] text-[color:var(--color-luxe-subtext)] rounded text-xs">
          {tag}
        </li>
      ))
    }
  </ul>
</article>
