---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  class?: string;
  target?: string;
  rel?: string;
  umamiEvent?: string;
}

const {
  href,
  variant = 'primary',
  class: className = '',
  target,
  rel,
  umamiEvent,
} = Astro.props;

const base =
  'inline-flex items-center justify-center px-6 py-2.5 rounded-lg font-medium focus:outline-none focus:ring-2 focus:ring-[color:var(--color-luxe-accent)] focus:ring-offset-2 focus:ring-offset-[color:var(--color-luxe-background)]';

const variants = {
  primary:
    'btn-motion btn-motion-primary bg-[color:var(--color-luxe-accent)] text-[color:var(--color-luxe-text)] hover:opacity-95',
  secondary:
    'btn-motion bg-[color:var(--color-luxe-card)] text-[color:var(--color-luxe-text)] border border-[color:var(--color-luxe-border)] hover:border-[color:var(--color-luxe-accent)]/40',
  text: 'btn-motion-text text-[color:var(--color-luxe-accent)] hover:text-[color:var(--color-luxe-link)] px-0 py-0 rounded-sm underline-offset-4 hover:underline',
};
---

<a
  href={href}
  class:list={[base, variants[variant], className]}
  target={target}
  rel={rel}
  data-umami-event={umamiEvent}
>
  <slot />
</a>
