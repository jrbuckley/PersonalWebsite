---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Reveal from '../components/Reveal.astro';
import { siteConfig } from '../content/site';
---

<Layout
  title="About | Jorge Buckley"
  description="Software engineer with six years of experience in React and TypeScript. Side projects, notes, and freelance frontend work."
>
  <Container class="space-y-12" width="narrow">
    <Reveal as="header" class="space-y-4">
      <h1 class="text-4xl font-bold text-[color:var(--color-luxe-text)]">
        I build interfaces teams can actually maintain.
      </h1>
      <p class="text-lg text-[color:var(--color-luxe-subtext)]">
        I've been a software engineer for six years, mostly in React and TypeScript. At American Express I've led frontend work on marketing tech apps, mentored engineers, interviewed React candidates, and built AI and document-processing tools.
      </p>
      <p class="text-lg text-[color:var(--color-luxe-subtext)]">
        I care about making confusing workflows feel simple, and leaving code that other people can work with.{' '}
        <a href="/contact" class="text-[color:var(--color-luxe-accent)] hover:underline">
          I take freelance projects when the fit is right.
        </a>{' '}
        This site is my portfolio and a place to write.
      </p>
      <p class="text-lg text-[color:var(--color-luxe-subtext)]">
        Outside of that, I build things under{' '}
        <a
          href={siteConfig.selumaStudio}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[color:var(--color-luxe-accent)] hover:underline"
        >
          Seluma Studio
        </a>{' '}
        and post notes when I have something worth sharing.
      </p>
    </Reveal>

    <Reveal as="section" aria-labelledby="experience-heading" class="space-y-6">
      <h2 id="experience-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Experience
      </h2>
      <div class="space-y-6">
        <article class="interactive-card border border-[color:var(--color-luxe-border)] rounded-lg p-6 space-y-3">
          <div>
            <h3 class="text-lg font-semibold text-[color:var(--color-luxe-text)] m-0">
              Software Engineer
            </h3>
            <p class="text-sm text-[color:var(--color-luxe-subtext)] m-0 mt-1">
              American Express · 2022 - Present
            </p>
          </div>
          <ul class="list-disc pl-5 space-y-2 text-[color:var(--color-luxe-subtext)]">
            <li>UI lead across three scrum teams for marketing technology applications.</li>
            <li>Led frontend development for a generative AI marketing proof of concept using React and language-model integration.</li>
            <li>Built Python REST APIs to extract relevant data from PDFs and images using document AI.</li>
            <li>Led React engineer interviews and mentored junior engineers through reviews and standards.</li>
            <li>Led contractor engineers while maintaining shared frontend quality expectations.</li>
          </ul>
        </article>

        <article class="interactive-card border border-[color:var(--color-luxe-border)] rounded-lg p-6 space-y-3">
          <div>
            <h3 class="text-lg font-semibold text-[color:var(--color-luxe-text)] m-0">
              Technology Senior Analyst
            </h3>
            <p class="text-sm text-[color:var(--color-luxe-subtext)] m-0 mt-1">
              Accenture · 2020 - 2022
            </p>
          </div>
          <ul class="list-disc pl-5 space-y-2 text-[color:var(--color-luxe-subtext)]">
            <li>Updated PEGA applications for accessibility with JavaScript and UI/UX mockups.</li>
            <li>Supported EHR-related Salesforce testing with SOQL validation work.</li>
            <li>Organized Hour of Code events engaging 300+ students across five schools.</li>
          </ul>
        </article>
      </div>
    </Reveal>

    <Reveal as="section" aria-labelledby="focus-heading" class="space-y-4">
      <h2 id="focus-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Technical focus
      </h2>
      <p class="text-[color:var(--color-luxe-subtext)]">
        Day to day: React, TypeScript, shared components, Jest and React Testing Library, Python APIs, and AI features in real products.
      </p>
      <p class="text-[color:var(--color-luxe-subtext)]">
        On the side: Astro, Next.js, React Native / Expo, Node.js, and Tailwind CSS. See{' '}
        <a href="/work" class="text-[color:var(--color-luxe-accent)] hover:underline">selected work</a>.
      </p>
    </Reveal>

    <Reveal as="section" aria-labelledby="education-heading" class="space-y-3">
      <h2 id="education-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Education
      </h2>
      <p class="text-[color:var(--color-luxe-subtext)]">
        Bachelor of Science in Computer Science, University of Florida · 2016 - 2020
      </p>
    </Reveal>

    <Reveal as="section" aria-labelledby="personal-heading" class="space-y-3">
      <h2 id="personal-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Outside of work
      </h2>
      <p class="text-[color:var(--color-luxe-subtext)]">
        Big sports fan (Tampa Bay Rays, Florida Gators, Carolina Panthers). I also cook a lot, stay active, and watch too many movies. Reviews live on{' '}
        <a
          href={siteConfig.letterboxd}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[color:var(--color-luxe-accent)] hover:underline"
        >
          Letterboxd
        </a>
        . I'm based in {siteConfig.location}.
      </p>
    </Reveal>

    <Reveal>
      <p class="text-lg text-[color:var(--color-luxe-subtext)] m-0">
        Have a project in mind?{' '}
        <a href="/contact" class="text-[color:var(--color-luxe-accent)] hover:underline">
          Get in touch
        </a>
        .
      </p>
    </Reveal>

    <Reveal class="flex flex-wrap gap-4">
      <ButtonLink href="/contact" umamiEvent="about-contact">
        Get in touch
      </ButtonLink>
      <ButtonLink
        href={siteConfig.resumePath}
        variant="secondary"
        target="_blank"
        rel="noopener noreferrer"
        umamiEvent="about-resume"
      >
        Download resume
      </ButtonLink>
    </Reveal>
  </Container>
</Layout>
