---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import ButtonLink from '../components/ButtonLink.astro';
import WorkCard from '../components/WorkCard.astro';
import Reveal from '../components/Reveal.astro';
import { siteConfig } from '../content/site';
import { homepageServiceCards } from '../content/services';
import { featuredWork } from '../content/work';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const latestNote = posts
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
  )
  .at(0);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  email: siteConfig.email,
  jobTitle: 'Software Engineer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Charlotte',
    addressRegion: 'NC',
    addressCountry: 'US',
  },
  sameAs: [siteConfig.github, siteConfig.linkedin],
};
---

<Layout
  title="Jorge Buckley | Software Engineer"
  description="Senior React engineer in Charlotte. Freelance frontend work, side projects, and notes on building software."
>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <Container class="space-y-20">
    <Reveal as="section" class="space-y-6" aria-labelledby="hero-heading">
      <p class="text-sm font-medium text-[color:var(--color-luxe-accent)] m-0">
        Charlotte, NC · available for freelance
      </p>
      <h1 id="hero-heading" class="text-4xl md:text-5xl font-bold text-[color:var(--color-luxe-text)] leading-tight">
        Senior React engineer
      </h1>
      <p class="text-lg md:text-xl text-[color:var(--color-luxe-subtext)] max-w-2xl">
        I help teams ship solid product UIs, clean up painful frontends, and wire AI features into real workflows. This site is also my portfolio and a place to write.
      </p>
      <div class="flex flex-wrap gap-4 items-center">
        <ButtonLink href="/services" umamiEvent="hero-view-services">
          View services
        </ButtonLink>
        <ButtonLink href="/work" variant="secondary" umamiEvent="hero-see-work">
          See selected work
        </ButtonLink>
        <ButtonLink href="/blog" variant="text" umamiEvent="hero-notes">
          Read notes
        </ButtonLink>
      </div>
    </Reveal>

    <Reveal as="section" aria-label="Credibility" class="border-y border-[color:var(--color-luxe-border)] py-6" delay={80}>
      <p class="text-sm text-[color:var(--color-luxe-subtext)] m-0">
        {siteConfig.proofStrip.join(' · ')}
      </p>
    </Reveal>

    <Reveal as="section" aria-labelledby="services-heading" class="space-y-6">
      <div class="space-y-2">
        <h2 id="services-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
          Freelance help
        </h2>
        <p class="text-[color:var(--color-luxe-subtext)]">
          React and frontend work for teams that need senior help without hiring full-time.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          homepageServiceCards.map((card, index) => (
            <a
              href={`/services#${card.id}`}
              class="interactive-card group block bg-[color:var(--color-luxe-card)] border border-[color:var(--color-luxe-border)] rounded-lg p-6 h-full focus:outline-none focus:ring-2 focus:ring-[color:var(--color-luxe-accent)] focus:ring-offset-2 focus:ring-offset-[color:var(--color-luxe-background)]"
              data-umami-event={`home-service-${card.id}`}
              style={`transition-delay: ${index * 40}ms`}
            >
              <h3 class="text-lg font-medium text-[color:var(--color-luxe-text)] mb-3">
                {card.title}
              </h3>
              <p class="text-sm text-[color:var(--color-luxe-subtext)] mb-4">
                {card.description}
              </p>
              <span class="text-sm font-medium text-[color:var(--color-luxe-accent)] group-hover:underline">
                Learn more
              </span>
            </a>
          ))
        }
      </div>
    </Reveal>

    <Reveal as="section" aria-labelledby="work-heading" class="space-y-6">
      <div class="space-y-2">
        <h2 id="work-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
          Selected work
        </h2>
        <p class="text-[color:var(--color-luxe-subtext)]">
          Three sanitized case studies from day-job work I can talk about publicly.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          featuredWork.map((item) => (
            <WorkCard
              title={item.title}
              context={item.context}
              role={item.role}
              outcome={item.outcome}
              tags={item.tags}
              href={item.href}
              status={item.status}
              umamiEvent={`home-work-${item.slug}`}
            />
          ))
        }
      </div>
    </Reveal>

    <Reveal as="section" aria-labelledby="why-heading" class="space-y-4 max-w-2xl">
      <h2 id="why-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        How I like to work
      </h2>
      <p class="text-[color:var(--color-luxe-subtext)]">
        I like figuring out what the product should do, then building the UI carefully. Clear screens, reusable pieces, and code your team can keep working with after I'm gone.
      </p>
    </Reveal>

    {
      latestNote && (
        <Reveal as="section" aria-labelledby="notes-heading" class="space-y-4">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div class="space-y-2">
              <h2 id="notes-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)] m-0">
                From the notes
              </h2>
              <p class="text-[color:var(--color-luxe-subtext)] m-0">
                Stuff I've written about engineering and the tools I use.
              </p>
            </div>
            <a
              href="/blog"
              class="text-sm font-medium text-[color:var(--color-luxe-accent)] hover:underline focus:outline-none focus:ring-2 focus:ring-[color:var(--color-luxe-accent)] rounded"
              data-umami-event="home-all-notes"
            >
              All notes
            </a>
          </div>
          <a
            href={`/blog/${latestNote.slug}`}
            class="interactive-card block bg-[color:var(--color-luxe-card)] border border-[color:var(--color-luxe-border)] rounded-lg p-6 focus:outline-none focus:ring-2 focus:ring-[color:var(--color-luxe-accent)] focus:ring-offset-2 focus:ring-offset-[color:var(--color-luxe-background)]"
            data-umami-event="home-latest-note"
          >
            <h3 class="text-lg font-medium text-[color:var(--color-luxe-text)] mb-2">
              {latestNote.data.title}
            </h3>
            <p class="text-sm text-[color:var(--color-luxe-subtext)] mb-3">
              {latestNote.data.description}
            </p>
            <time
              class="text-xs text-[color:var(--color-luxe-subtext)]"
              datetime={new Date(latestNote.data.publishDate).toISOString()}
            >
              {new Date(latestNote.data.publishDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </a>
        </Reveal>
      )
    }

    <Reveal
      as="section"
      aria-labelledby="cta-heading"
      class="bg-[color:var(--color-luxe-card)] border border-[color:var(--color-luxe-border)] rounded-lg p-8 space-y-4"
    >
      <h2 id="cta-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Have a project in mind?
      </h2>
      <p class="text-[color:var(--color-luxe-subtext)] max-w-2xl">
        Tell me what you're building, what's stuck, and when you need it. I'll say quickly if I'm a good fit. Or just say hi.
      </p>
      <ButtonLink href="/contact" umamiEvent="home-start-conversation">
        Get in touch
      </ButtonLink>
    </Reveal>
  </Container>
</Layout>
