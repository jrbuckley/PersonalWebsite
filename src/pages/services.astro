---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import ButtonLink from '../components/ButtonLink.astro';
import {
  serviceOffers,
  engagementModels,
  processSteps,
  serviceFaqs,
} from '../content/services';
import { siteConfig, formatCurrency } from '../content/site';
import Reveal from '../components/Reveal.astro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${siteConfig.name} | Frontend Engineering`,
  url: `${siteConfig.siteUrl}/services`,
  description:
    'React product development, frontend modernization, and AI feature integration.',
  provider: {
    '@type': 'Person',
    name: siteConfig.name,
    url: siteConfig.siteUrl,
  },
  areaServed: 'US',
  priceRange: `${formatCurrency(siteConfig.pricing.hourlyFrom)}+/hour; projects from ${formatCurrency(siteConfig.pricing.projectFrom)}`,
};
---

<Layout
  title="Services | Jorge Buckley"
  description="Freelance React builds, frontend modernization, and AI feature work. Fixed-scope projects and part-time support."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <Container class="space-y-16">
    <Reveal as="header" class="space-y-4 max-w-2xl">
      <h1 class="text-4xl font-bold text-[color:var(--color-luxe-text)]">
        Freelance frontend work with a defined finish line.
      </h1>
      <p class="text-lg text-[color:var(--color-luxe-subtext)]">
        I work with small teams on React builds, cleanup/modernization, and AI features in the product. I like a clear outcome better than an endless backlog, then I hand things off cleanly.
      </p>
    </Reveal>

    <Reveal as="section" aria-labelledby="offers-heading" class="space-y-8">
      <h2 id="offers-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Offers
      </h2>
      {
        serviceOffers.map((offer) => (
          <article
            id={offer.id}
            class="interactive-card scroll-mt-24 bg-[color:var(--color-luxe-card)] border border-[color:var(--color-luxe-border)] rounded-lg p-6 md:p-8 space-y-4"
          >
            <h3 class="text-xl font-semibold text-[color:var(--color-luxe-text)]">
              {offer.title}
            </h3>
            <p class="text-[color:var(--color-luxe-subtext)]">
              <span class="font-medium text-[color:var(--color-luxe-text)]">Best for:</span>{' '}
              {offer.bestFor}
            </p>
            <div>
              <h4 class="text-sm font-medium text-[color:var(--color-luxe-text)] mb-2">
                Typical work
              </h4>
              <ul class="list-disc pl-5 space-y-1 text-[color:var(--color-luxe-subtext)]">
                {offer.typicalWork.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <p class="text-[color:var(--color-luxe-subtext)]">
              <span class="font-medium text-[color:var(--color-luxe-text)]">Deliverable:</span>{' '}
              {offer.deliverable}
            </p>
          </article>
        ))
      }
    </Reveal>

    <Reveal as="section" aria-labelledby="engagement-heading" class="space-y-6">
      <h2 id="engagement-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Engagement models
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          engagementModels.map((model) => (
            <div class="interactive-card border border-[color:var(--color-luxe-border)] rounded-lg p-6 space-y-2">
              <h3 class="text-lg font-medium text-[color:var(--color-luxe-text)]">{model.title}</h3>
              <p class="text-sm text-[color:var(--color-luxe-subtext)]">{model.description}</p>
              <p class="text-sm font-medium text-[color:var(--color-luxe-accent)]">{model.detail}</p>
            </div>
          ))
        }
      </div>
      <p class="text-sm text-[color:var(--color-luxe-subtext)]">
        Rates are starting points. We lock pricing after a short conversation about scope.
      </p>
    </Reveal>

    <Reveal as="section" aria-labelledby="process-heading" class="space-y-6">
      <h2 id="process-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Process
      </h2>
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-6 list-none m-0 p-0 counter-reset">
        {
          processSteps.map((step, index) => (
            <li class="interactive-card border border-[color:var(--color-luxe-border)] rounded-lg p-6 space-y-2">
              <p class="text-xs font-medium text-[color:var(--color-luxe-accent)] m-0">
                Step {index + 1}
              </p>
              <h3 class="text-lg font-medium text-[color:var(--color-luxe-text)] m-0">{step.title}</h3>
              <p class="text-sm text-[color:var(--color-luxe-subtext)] m-0">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </Reveal>

    <Reveal as="section" aria-labelledby="faq-heading" class="space-y-6">
      <h2 id="faq-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Frequently asked questions
      </h2>
      <div class="space-y-4">
        {
          serviceFaqs.map((faq) => (
            <details class="border border-[color:var(--color-luxe-border)] rounded-lg p-4 group transition-colors hover:border-[color:var(--color-luxe-accent)]/35">
              <summary class="cursor-pointer font-medium text-[color:var(--color-luxe-text)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-luxe-accent)] rounded list-none flex justify-between items-center gap-4">
                {faq.question}
                <span class="text-[color:var(--color-luxe-subtext)] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-[color:var(--color-luxe-subtext)] m-0">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </Reveal>

    <Reveal
      as="section"
      aria-labelledby="services-cta-heading"
      class="bg-[color:var(--color-luxe-card)] border border-[color:var(--color-luxe-border)] rounded-lg p-8 space-y-4"
    >
      <h2 id="services-cta-heading" class="text-2xl font-semibold text-[color:var(--color-luxe-text)]">
        Want to talk through a project?
      </h2>
      <p class="text-[color:var(--color-luxe-subtext)]">
        Tell me what you're building and when you need it. I'll reply with whether I'm a fit and what I'd suggest next.
      </p>
      <ButtonLink href="/contact" umamiEvent="services-contact-cta">
        Get in touch
      </ButtonLink>
    </Reveal>
  </Container>
</Layout>
