---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Page Not Found" noindex={true}>
  <div class="max-w-4xl mx-auto px-4 py-16 text-center space-y-6">
    <h1 class="text-4xl font-bold text-[color:var(--color-luxe-text)]">Page not found</h1>
    <p class="text-[color:var(--color-luxe-subtext)]">
      That page doesn't exist, or it moved.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="/"
        class="inline-block px-6 py-3 bg-[color:var(--color-luxe-accent)] text-[color:var(--color-luxe-text)] rounded-lg hover:opacity-90 transition-colors focus:outline-none focus:ring-2 focus:ring-[color:var(--color-luxe-accent)] focus:ring-offset-2"
      >
        Home
      </a>
      <a
        href="/contact"
        class="inline-block px-6 py-3 bg-[color:var(--color-luxe-card)] border border-[color:var(--color-luxe-border)] text-[color:var(--color-luxe-text)] rounded-lg hover:opacity-90 transition-colors focus:outline-none focus:ring-2 focus:ring-[color:var(--color-luxe-accent)] focus:ring-offset-2"
      >
        Contact
      </a>
    </div>
  </div>
</Layout>